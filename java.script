
// SANTIAGO SOLIDÁRIA ❤️

// ELEMENTOS E DADOS

const $ = id => document.getElementById(id);

const PROFILE = "santiagoProfile";
const CALLS = "santiagoCalls";
const DEFAULT_PHOTO = "https://placehold.co/120x120/e8f3ed/26734d?text=Foto";

function load(key, fallback) {
    try {
        return JSON.parse(localStorage.getItem(key)) || fallback;
    } catch {
        return fallback;
    }
}

let profile = load(PROFILE, null);
let calls = load(CALLS, []).map(call => ({
    ...call,
    categories: call.categories || [call.category || "Outros"],
    status: call.status === "atendido" ? "done" :
            call.status === "aberto" ? "open" : call.status
}));

let map = null;
let markers = null;
let selectedLocation = null;
let selecting = false;
let temporaryMarker = null;
let selectedPhoto = "";

function save() {
    localStorage.setItem(CALLS, JSON.stringify(calls));
}


// FOTO DE PERFIL

$("profilePhoto").addEventListener("change", event => {
    const file = event.target.files[0];
    if (!file) return;

    if (!file.type.startsWith("image/") || file.size > 5 * 1024 * 1024) {
        alert("Escolha uma imagem válida de até 5 MB.");
        return;
    }

    const reader = new FileReader();

    reader.onload = event => {
        const img = new Image();

        img.onload = () => {
            const canvas = document.createElement("canvas");
            canvas.width = canvas.height = 250;

            const size = Math.min(img.width, img.height);
            const x = (img.width - size) / 2;
            const y = (img.height - size) / 2;

            canvas.getContext("2d").drawImage(
                img, x, y, size, size, 0, 0, 250, 250
            );

            selectedPhoto = canvas.toDataURL("image/jpeg", 0.7);
            $("photoPreview").src = selectedPhoto;
        };

        img.src = event.target.result;
    };

    reader.readAsDataURL(file);
});


// CADASTRO

$("registerForm").addEventListener("submit", event => {
    event.preventDefault();

    profile = {
        name: $("personName").value.trim(),
        street: $("street").value.trim(),
        neighborhood: $("neighborhood").value.trim(),
        houseNumber: $("houseNumber").value.trim(),
        phone: $("phone").value.trim(),
        photo: selectedPhoto || profile?.photo || ""
    };

    if (!profile.name || !profile.street ||
        !profile.neighborhood || !profile.houseNumber) {
        alert("Preencha todos os campos obrigatórios.");
        return;
    }

    localStorage.setItem(PROFILE, JSON.stringify(profile));
    showApp();
});


// MOSTRAR CADASTRO

function showRegister() {
    $("appScreen").classList.add("hidden");
    $("registerScreen").classList.remove("hidden");

    if (!profile) {
        $("registerForm").reset();
        selectedPhoto = "";
        $("photoPreview").src = DEFAULT_PHOTO;
        return;
    }

    $("personName").value = profile.name;
    $("street").value = profile.street;
    $("neighborhood").value = profile.neighborhood;
    $("houseNumber").value = profile.houseNumber;
    $("phone").value = profile.phone || "";

    selectedPhoto = profile.photo || "";
    $("photoPreview").src = selectedPhoto || DEFAULT_PHOTO;
}


// MOSTRAR APLICATIVO

function showApp() {
    $("registerScreen").classList.add("hidden");
    $("appScreen").classList.remove("hidden");

    $("welcomeName").textContent = profile.name.split(" ")[0];
    $("userPhoto").src = profile.photo || DEFAULT_PHOTO;
    $("callNeighborhood").value = profile.neighborhood;

    renderCalls();

    setTimeout(() => {
        if (!map) initMap();
        else map.invalidateSize();
    }, 200);
}


// EDITAR PERFIL E SAIR

$("editProfileBtn").onclick = showRegister;

$("logoutBtn").onclick = () => {
    if (!confirm("Deseja realmente sair da conta neste navegador?")) return;

    profile = null;
    selectedPhoto = "";

    localStorage.removeItem(PROFILE);
    showRegister();
};


// MAPA

function initMap() {
    map = L.map("map").setView([-29.1915, -54.8678], 14);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    markers = L.layerGroup().addTo(map);

    map.on("click", event => {
        if (!selecting) return;

        selectedLocation = [
            event.latlng.lat,
            event.latlng.lng
        ];

        if (temporaryMarker) map.removeLayer(temporaryMarker);

        temporaryMarker = L.marker(selectedLocation).addTo(map);

        $("locationStatus").textContent =
            "📍 Ponto de referência selecionado!";

        selecting = false;
        $("selectLocation").textContent = "Alterar localização";
    });

    renderMarkers();
}


// SELECIONAR LOCALIZAÇÃO

$("selectLocation").onclick = () => {
    selecting = true;

    $("locationStatus").textContent =
        "Clique no mapa para escolher um ponto público próximo.";

    $("selectLocation").textContent = "Clique no mapa...";
};


// PUBLICAR CHAMADO

$("callForm").addEventListener("submit", event => {
    event.preventDefault();

    const categories = [
        ...document.querySelectorAll('input[name="category"]:checked')
    ].map(item => item.value);

    const description = $("callDescription").value.trim();
    const neighborhood = $("callNeighborhood").value.trim();

    if (!categories.length) {
        alert("Selecione pelo menos uma categoria.");
        return;
    }

    if (!selectedLocation) {
        alert("Escolha um ponto de referência no mapa.");
        return;
    }

    if (!description || !neighborhood) {
        alert("Preencha a descrição e o bairro.");
        return;
    }

    const call = {
        id: Date.now().toString(),
        categories,
        description,
        neighborhood,
        requester: profile.name,
        requesterPhoto: profile.photo || "",
        status: "open",
        acceptedBy: "",
        progress: "",
        coordinates: selectedLocation,
        createdAt: new Date().toLocaleString("pt-BR")
    };

    calls.unshift(call);

    save();

    selectedLocation = null;
    selecting = false;

    if (temporaryMarker) {
        map.removeLayer(temporaryMarker);
        temporaryMarker = null;
    }

    $("locationStatus").textContent = "Nenhum local selecionado.";
    $("selectLocation").textContent = "Escolher localização";

    $("callForm").reset();
    $("callNeighborhood").value = profile.neighborhood;

    renderCalls();

    alert("Chamado publicado com sucesso!");
});


// PROTEÇÃO DE TEXTO

function safe(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
    })[char]);
}


// MOSTRAR CHAMADOS

function renderCalls() {
    const filter = $("statusFilter").value;

    const filtered = calls.filter(call =>
        filter === "all" || call.status === filter
    );

    $("openCount").textContent =
        calls.filter(c => c.status === "open").length;

    $("acceptedCount").textContent =
        calls.filter(c => c.status === "accepted").length;

    $("doneCount").textContent =
        calls.filter(c => c.status === "done").length;

    $("callsList").innerHTML = "";

    if (!filtered.length) {
        $("callsList").innerHTML =
            '<div class="empty">Nenhum chamado encontrado. ❤️</div>';
    }

    filtered.forEach(call => {
        const card = document.createElement("article");
        card.className = "call-card";

        const status = {
            open: "Aberto",
            accepted: "Em atendimento",
            done: "Concluído"
        }[call.status];

        const categories = call.categories
            .map(category => `<span class="category-tag">${safe(category)}</span>`)
            .join(" ");

        let action = "";

        if (call.status === "open" && call.requester !== profile.name) {
            action = `<button class="accept-btn" onclick="acceptCall('${call.id}')">
                Aceitar chamado
            </button>`;
        }

        // CHAMADO EM ATENDIMENTO

        if (call.status === "accepted") {
            action = `<p>🤝 Em atendimento por ${safe(call.acceptedBy)}</p>`;

            // SOLICITANTE OU RESPONSÁVEL PODE ATUALIZAR

            if (call.acceptedBy === profile.name ||
                call.requester === profile.name) {

                action += `
                    <button class="secondary"
                        onclick="updateProgress('${call.id}')">
                        Atualizar andamento
                    </button>
                `;
            }

            // SOMENTE QUEM ACEITOU PODE CONCLUIR

            if (call.acceptedBy === profile.name) {
                action += `<button class="complete-btn" onclick="completeCall('${call.id}')">
                    Marcar como concluído
                </button>`;
            }

            if (call.progress) {
                action += `<p>📌 Andamento: ${safe(call.progress)}</p>`;
                action += `<p>🕒 Última atualização: ${safe(call.updatedAt || "")}</p>`;
            }
        }

        if (call.status === "done") {
            action = "<p>❤️ Necessidade atendida!</p>";

            if (call.progress) {
                action += `<p>📌 Último andamento: ${safe(call.progress)}</p>`;
            }
        }

        card.innerHTML = `
            <div class="call-top">
                ${categories}
                <span class="status status-${call.status}">${status}</span>
            </div>

            <h3>${safe(call.description)}</h3>

            <p>📍 ${safe(call.neighborhood)}</p>
            <p>👤 ${safe(call.requester)}</p>
            <p>📅 ${safe(call.createdAt)}</p>

            ${action}
        `;

        $("callsList").appendChild(card);
    });

    renderMarkers();
}


// FILTROS

$("statusFilter").addEventListener("change", renderCalls);


// ACEITAR CHAMADO

function acceptCall(id) {
    const call = calls.find(item => item.id === id);

    if (!call || call.status !== "open") return;

    if (call.requester === profile.name) {
        alert("Você não pode aceitar seu próprio chamado.");
        return;
    }

    call.status = "accepted";
    call.acceptedBy = profile.name;

    save();
    renderCalls();

    alert("Obrigado por ajudar alguém de Santiago!");
}


// ATUALIZAR ANDAMENTO DO CHAMADO

function updateProgress(id) {
    const call = calls.find(item => item.id === id);

    if (!call) return;

    if (call.requester !== profile.name &&
        call.acceptedBy !== profile.name) {
        alert("Você não tem permissão para atualizar este chamado.");
        return;
    }

    if (call.status !== "accepted") return;

    const progress = prompt("Informe o andamento do pedido:", call.progress || "");

    if (progress === null || !progress.trim()) return;

    call.progress = progress.trim();
    call.updatedAt = new Date().toLocaleString("pt-BR");

    save();
    renderCalls();

    alert("Andamento atualizado com sucesso! ❤️");
}


// CONCLUIR CHAMADO

function completeCall(id) {
    const call = calls.find(item => item.id === id);

    if (!call || call.acceptedBy !== profile.name) return;

    if (!confirm("Deseja marcar este chamado como concluído?")) return;

    call.status = "done";

    save();
    renderCalls();

    alert("Chamado concluído! Obrigado pela solidariedade.");
}


// MARCADORES DO MAPA

function renderMarkers() {
    if (!map || !markers) return;

    markers.clearLayers();

    calls.forEach(call => {
        if (!call.coordinates || !Array.isArray(call.coordinates)) return;

        if (call.status === "done") return;

        const marker = L.marker(call.coordinates).addTo(markers);

        const categories = call.categories
            .map(safe)
            .join(", ");

        marker.bindPopup(`
            <strong>${categories}</strong>
            <p>${safe(call.description)}</p>
            <p>📍 ${safe(call.neighborhood)}</p>
            <p>Status: ${safe(call.status)}</p>
        `);
    });
}


// INICIALIZAÇÃO

if (profile) {
    showApp();
} else {
    showRegister();
}

window.acceptCall = acceptCall;
window.completeCall = completeCall;
window.updateProgress = updateProgress;
