
// ==========================================
// SANTIAGO SOLIDÁRIA ❤️
// JAVASCRIPT OTIMIZADO
// PARTE 1 - CONFIGURAÇÕES E CADASTRO
// ==========================================

// ==========================================
// ELEMENTOS
// ==========================================

const $ = id => document.getElementById(id);

const PROFILE = "santiagoProfile";
const CALLS = "santiagoCalls";

const DEFAULT_PHOTO =
    "https://placehold.co/120x120/e8f3ed/26734d?text=Foto";

// ==========================================
// ARMAZENAMENTO
// ==========================================

function load(key, fallback) {
    try {
        return JSON.parse(localStorage.getItem(key)) ?? fallback;
    } catch (error) {
        console.error("Erro ao carregar dados:", error);
        return fallback;
    }
}

function store(key, value) {
    try {
        localStorage.setItem(key, JSON.stringify(value));
        return true;
    } catch (error) {
        console.error("Erro ao salvar dados:", error);
        alert("Não foi possível salvar. Verifique o espaço disponível no navegador.");
        return false;
    }
}

let profile = load(PROFILE, null);

let calls = load(CALLS, []).map(call => ({
    ...call,
    categories: call.categories || [call.category || "Outros"],
    status:
        call.status === "atendido" ? "done" :
        call.status === "aberto" ? "open" :
        call.status || "open"
}));

let map = null;
let markers = null;

let selectedLocation = null;
let selecting = false;
let temporaryMarker = null;
let selectedPhoto = "";

function save() {
    return store(CALLS, calls);
}

// ==========================================
// NAVEGAÇÃO
// ==========================================

function showLanding() {
    $("landingScreen").classList.remove("hidden");
    $("registerScreen").classList.add("hidden");
    $("appScreen").classList.add("hidden");

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

function openRegister() {
    $("landingScreen").classList.add("hidden");
    $("appScreen").classList.add("hidden");
    $("registerScreen").classList.remove("hidden");

    if (profile) {
        $("personName").value = profile.name || "";
        $("street").value = profile.street || "";
        $("neighborhood").value = profile.neighborhood || "";
        $("houseNumber").value = profile.houseNumber || "";
        $("phone").value = profile.phone || "";

        selectedPhoto = profile.photo || "";

        $("photoPreview").src =
            selectedPhoto || DEFAULT_PHOTO;

    } else {
        $("registerForm").reset();

        selectedPhoto = "";

        $("photoPreview").src = DEFAULT_PHOTO;
    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

// ==========================================
// BOTÕES DE PARTICIPAÇÃO
// ==========================================

[
    "joinBtn",
    "heroJoinBtn",
    "aboutJoinBtn",
    "finalJoinBtn"
].forEach(id => {
    $(id)?.addEventListener("click", openRegister);
});

// VOLTAR AO INÍCIO

$("backLandingBtn")?.addEventListener(
    "click",
    showLanding
);

// ==========================================
// FOTO DE PERFIL
// ==========================================

$("profilePhoto").addEventListener("change", event => {

    const file = event.target.files[0];

    if (!file) return;

    if (
        !file.type.startsWith("image/") ||
        file.size > 5 * 1024 * 1024
    ) {
        alert("Escolha uma imagem válida de até 5 MB.");

        event.target.value = "";

        return;
    }

    const reader = new FileReader();

    reader.onload = event => {

        const img = new Image();

        img.onload = () => {

            const canvas = document.createElement("canvas");

            canvas.width = 250;
            canvas.height = 250;

            const size = Math.min(img.width, img.height);

            const x = (img.width - size) / 2;
            const y = (img.height - size) / 2;

            const context = canvas.getContext("2d");

            context.drawImage(
                img,
                x, y, size, size,
                0, 0, 250, 250
            );

            selectedPhoto = canvas.toDataURL(
                "image/jpeg",
                0.7
            );

            $("photoPreview").src = selectedPhoto;
        };

        img.onerror = () => {
            alert("Não foi possível carregar essa imagem.");
        };

        img.src = event.target.result;
    };

    reader.onerror = () => {
        alert("Erro ao ler a imagem selecionada.");
    };

    reader.readAsDataURL(file);
});

// ==========================================
// CADASTRO
// ==========================================

$("registerForm").addEventListener("submit", event => {

    event.preventDefault();

    const newProfile = {

        name: $("personName").value.trim(),

        street: $("street").value.trim(),

        neighborhood: $("neighborhood").value.trim(),

        houseNumber: $("houseNumber").value.trim(),

        phone: $("phone").value.trim(),

        photo: selectedPhoto || profile?.photo || ""
    };

    if (
        !newProfile.name ||
        !newProfile.street ||
        !newProfile.neighborhood ||
        !newProfile.houseNumber
    ) {
        alert("Preencha todos os campos obrigatórios.");
        return;
    }

    // SALVAR PERFIL

    if (!store(PROFILE, newProfile)) {
        return;
    }

    profile = newProfile;

    selectedPhoto = profile.photo;

    showApp();
});

// ==========================================
// MOSTRAR APLICATIVO
// ==========================================

function showApp() {

    if (!profile) {
        openRegister();
        return;
    }

    $("landingScreen").classList.add("hidden");
    $("registerScreen").classList.add("hidden");
    $("appScreen").classList.remove("hidden");

    $("welcomeName").textContent =
        profile.name.split(" ")[0];

    $("userPhoto").src =
        profile.photo || DEFAULT_PHOTO;

    $("callNeighborhood").value =
        profile.neighborhood || "";

    renderCalls();

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

    setTimeout(() => {

        if (!map) {
            initMap();
        } else {
            map.invalidateSize();
            renderMarkers();
        }

    }, 300);
}

// ==========================================
// EDITAR PERFIL
// ==========================================

$("editProfileBtn").addEventListener(
    "click",
    openRegister
);

// ==========================================
// SAIR DA CONTA
// ==========================================

$("logoutBtn").addEventListener("click", () => {

    if (!confirm("Deseja realmente sair da conta neste navegador?")) {
        return;
    }

    profile = null;
    selectedPhoto = "";

    localStorage.removeItem(PROFILE);

    showLanding();
});

// ==========================================
// FIM DA PARTE 1
// A PARTE 2 CONTINUARÁ AQUI
// ==========================================


// ==========================================
// SANTIAGO SOLIDÁRIA ❤️
// PARTE 2 - MAPA E CHAMADOS
// ==========================================

// ==========================================
// MAPA DE SANTIAGO
// ==========================================

function initMap() {

    if (!window.L || !$("map")) {
        alert("Não foi possível carregar o mapa. Verifique sua conexão.");
        return;
    }

    map = L.map("map").setView(
        [-29.1915, -54.8678],
        14
    );

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution: "&copy; OpenStreetMap contributors"
        }
    ).addTo(map);

    markers = L.layerGroup().addTo(map);

    // CLIQUE NO MAPA PARA SELECIONAR LOCAL

    map.on("click", event => {

        if (!selecting) return;

        selectedLocation = [
            event.latlng.lat,
            event.latlng.lng
        ];

        if (temporaryMarker) {
            map.removeLayer(temporaryMarker);
        }

        temporaryMarker = L.marker(
            selectedLocation
        ).addTo(map);

        $("locationStatus").textContent =
            "📍 Ponto de referência selecionado!";

        selecting = false;

        $("selectLocation").textContent =
            "Alterar localização";
    });

    renderMarkers();
}

// ==========================================
// SELECIONAR LOCALIZAÇÃO
// ==========================================

$("selectLocation").addEventListener("click", () => {

    if (!map) {
        alert("O mapa ainda não foi carregado.");
        return;
    }

    selecting = true;

    $("locationStatus").textContent =
        "Clique no mapa para escolher um ponto público próximo.";

    $("selectLocation").textContent =
        "Clique no mapa...";

});

// ==========================================
// SEGURANÇA DE TEXTO
// ==========================================

function safe(value) {

    return String(value ?? "").replace(
        /[&<>"']/g,
        char => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#039;"
        })[char]
    );
}

// ==========================================
// PUBLICAR CHAMADO
// ==========================================

$("callForm").addEventListener("submit", event => {

    event.preventDefault();

    if (!profile) {
        alert("Faça seu cadastro antes de publicar um chamado.");
        openRegister();
        return;
    }

    // CATEGORIAS SELECIONADAS

    const categories = [
        ...document.querySelectorAll(
            'input[name="category"]:checked'
        )
    ].map(item => item.value);

    // INFORMAÇÕES DO CHAMADO

    const description =
        $("callDescription").value.trim();

    const neighborhood =
        $("callNeighborhood").value.trim();

    // VALIDAÇÕES

    if (!categories.length) {
        alert("Selecione pelo menos uma categoria.");
        return;
    }

    if (!description) {
        alert("Descreva sua necessidade.");
        return;
    }

    if (!neighborhood) {
        alert("Informe o bairro.");
        return;
    }

    if (!selectedLocation) {
        alert("Escolha um ponto de referência no mapa.");
        return;
    }

    // CRIAR CHAMADO

    const call = {

        id: crypto.randomUUID
            ? crypto.randomUUID()
            : Date.now().toString(),

        categories,

        description,

        neighborhood,

        requester: profile.name,

        requesterPhoto: profile.photo || "",

        status: "open",

        acceptedBy: "",

        progress: "",

        coordinates: [...selectedLocation],

        createdAt: new Date().toLocaleString("pt-BR")

    };

    // ADICIONAR À LISTA

    calls.unshift(call);

    // SALVAR

    if (!save()) {

        calls.shift();

        return;
    }

    // LIMPAR LOCALIZAÇÃO TEMPORÁRIA

    selectedLocation = null;
    selecting = false;

    if (temporaryMarker && map) {

        map.removeLayer(temporaryMarker);

        temporaryMarker = null;
    }

    $("locationStatus").textContent =
        "Nenhum local selecionado.";

    $("selectLocation").textContent =
        "Escolher localização";

    // LIMPAR FORMULÁRIO

    $("callForm").reset();

    $("callNeighborhood").value =
        profile.neighborhood || "";

    // ATUALIZAR APLICATIVO

    renderCalls();

    alert("Chamado publicado com sucesso! ❤️");

});

// ==========================================
// FIM DA PARTE 2
// A PARTE 3 CONTINUARÁ AQUI
// ==========================================


// ==========================================
// SANTIAGO SOLIDÁRIA ❤️
// PARTE 3 - CHAMADOS E ATENDIMENTO
// ==========================================

// ==========================================
// MOSTRAR CHAMADOS
// ==========================================

function renderCalls() {

    const filter = $("statusFilter").value;

    const filtered = calls.filter(call =>
        filter === "all" || call.status === filter
    );

    // ATUALIZAR ESTATÍSTICAS

    $("openCount").textContent =
        calls.filter(c => c.status === "open").length;

    $("acceptedCount").textContent =
        calls.filter(c => c.status === "accepted").length;

    $("doneCount").textContent =
        calls.filter(c => c.status === "done").length;

    // LIMPAR LISTA

    $("callsList").innerHTML = "";

    if (!filtered.length) {

        $("callsList").innerHTML = `
            <div class="empty">
                Nenhum chamado encontrado. ❤️
            </div>
        `;

    }

    // CRIAR CARTÕES

    filtered.forEach(call => {

        const card = document.createElement("article");

        card.className = "call-card";

        const status = {

            open: "Aberto",

            accepted: "Em atendimento",

            done: "Concluído"

        }[call.status] || "Aberto";

        // CATEGORIAS

        const categories = call.categories
            .map(category => `
                <span class="category-tag">
                    ${safe(category)}
                </span>
            `)
            .join(" ");

        let action = "";

        // ==================================
        // ACEITAR CHAMADO
        // ==================================

        if (
            call.status === "open" &&
            call.requester !== profile?.name
        ) {

            action = `
                <button class="accept-btn"
                    onclick="acceptCall('${safe(call.id)}')">

                    Aceitar chamado

                </button>
            `;

        }

        // ==================================
        // CHAMADO EM ATENDIMENTO
        // ==================================

        if (call.status === "accepted") {

            action = `
                <p>
                    🤝 Em atendimento por
                    ${safe(call.acceptedBy)}
                </p>
            `;

            // SOLICITANTE OU RESPONSÁVEL

            if (
                call.acceptedBy === profile?.name ||
                call.requester === profile?.name
            ) {

                action += `
                    <button class="secondary"
                        onclick="updateProgress('${safe(call.id)}')">

                        Atualizar andamento

                    </button>
                `;

            }

            // SOMENTE QUEM ACEITOU PODE CONCLUIR

            if (call.acceptedBy === profile?.name) {

                action += `
                    <button class="complete-btn"
                        onclick="completeCall('${safe(call.id)}')">

                        Marcar como concluído

                    </button>
                `;

            }

            // MOSTRAR ATUALIZAÇÃO

            if (call.progress) {

                action += `
                    <p>
                        📌 Andamento:
                        ${safe(call.progress)}
                    </p>

                    <p>
                        🕒 Última atualização:
                        ${safe(call.updatedAt || "")}
                    </p>
                `;

            }

        }

        // ==================================
        // CHAMADO CONCLUÍDO
        // ==================================

        if (call.status === "done") {

            action = `
                <p>
                    ❤️ Necessidade atendida!
                </p>
            `;

            if (call.progress) {

                action += `
                    <p>
                        📌 Último andamento:
                        ${safe(call.progress)}
                    </p>
                `;

            }

        }

        // ==================================
        // CONTEÚDO DO CARTÃO
        // ==================================

        card.innerHTML = `

            <div class="call-top">

                ${categories}

                <span class="status status-${safe(call.status)}">

                    ${status}

                </span>

            </div>

            <h3>
                ${safe(call.description)}
            </h3>

            <p>
                📍 ${safe(call.neighborhood)}
            </p>

            <p>
                👤 ${safe(call.requester)}
            </p>

            <p>
                📅 ${safe(call.createdAt)}
            </p>

            ${action}

        `;

        $("callsList").appendChild(card);

    });

    // ATUALIZAR MAPA

    renderMarkers();

}

// ==========================================
// FILTRO DE CHAMADOS
// ==========================================

$("statusFilter").addEventListener(
    "change",
    renderCalls
);

// ==========================================
// ACEITAR CHAMADO
// ==========================================

function acceptCall(id) {

    const call = calls.find(item => item.id === id);

    if (!call || !profile) return;

    if (call.status !== "open") {

        alert("Este chamado não está mais disponível.");

        return;
    }

    if (call.requester === profile.name) {

        alert("Você não pode aceitar seu próprio chamado.");

        return;
    }

    // ATUALIZAR STATUS

    const previousStatus = call.status;
    const previousAcceptedBy = call.acceptedBy;

    call.status = "accepted";

    call.acceptedBy = profile.name;

    if (!save()) {

        call.status = previousStatus;
        call.acceptedBy = previousAcceptedBy;

        return;
    }

    renderCalls();

    alert("Obrigado por ajudar alguém de Santiago! ❤️");

}

// ==========================================
// ATUALIZAR ANDAMENTO
// ==========================================

function updateProgress(id) {

    const call = calls.find(item => item.id === id);

    if (!call || !profile) return;

    if (
        call.requester !== profile.name &&
        call.acceptedBy !== profile.name
    ) {

        alert("Você não tem permissão para atualizar este chamado.");

        return;
    }

    if (call.status !== "accepted") return;

    const progress = prompt(
        "Informe o andamento do pedido:",
        call.progress || ""
    );

    if (progress === null || !progress.trim()) return;

    const previousProgress = call.progress;
    const previousUpdatedAt = call.updatedAt;

    call.progress = progress.trim();

    call.updatedAt =
        new Date().toLocaleString("pt-BR");

    if (!save()) {

        call.progress = previousProgress;
        call.updatedAt = previousUpdatedAt;

        return;
    }

    renderCalls();

    alert("Andamento atualizado com sucesso! ❤️");

}

// ==========================================
// CONCLUIR CHAMADO
// ==========================================

function completeCall(id) {

    const call = calls.find(item => item.id === id);

    if (!call || !profile) return;

    if (
        call.status !== "accepted" ||
        call.acceptedBy !== profile.name
    ) {

        alert("Você não pode concluir este chamado.");

        return;
    }

    if (!confirm("Deseja marcar este chamado como concluído?")) {

        return;
    }

    const previousStatus = call.status;

    call.status = "done";

    if (!save()) {

        call.status = previousStatus;

        return;
    }

    renderCalls();

    alert(
        "Chamado concluído! Obrigado pela solidariedade. ❤️"
    );

}

// ==========================================
// MARCADORES DO MAPA
// ==========================================

function renderMarkers() {

    if (!map || !markers) return;

    markers.clearLayers();

    calls.forEach(call => {

        if (
            !call.coordinates ||
            !Array.isArray(call.coordinates) ||
            call.coordinates.length !== 2
        ) {

            return;
        }

        // NÃO MOSTRAR CHAMADOS CONCLUÍDOS

        if (call.status === "done") return;

        const marker = L.marker(
            call.coordinates
        ).addTo(markers);

        const categories = call.categories
            .map(safe)
            .join(", ");

        // INFORMAÇÕES DO MARCADOR

        marker.bindPopup(`

            <strong>
                ${categories}
            </strong>

            <p>
                ${safe(call.description)}
            </p>

            <p>
                📍 ${safe(call.neighborhood)}
            </p>

            <p>
                Status: ${safe(call.status)}
            </p>

        `);

    });

}

// ==========================================
// INICIALIZAÇÃO DO APLICATIVO
// ==========================================

if (profile) {

    showApp();

} else {

    showLanding();

}

// ==========================================
// DISPONIBILIZAR FUNÇÕES
// ==========================================

window.acceptCall = acceptCall;

window.updateProgress = updateProgress;

window.completeCall = completeCall;

window.openRegister = openRegister;

window.showLanding = showLanding;

// ==========================================
// FIM DO JAVASCRIPT ❤️
// ==========================================
